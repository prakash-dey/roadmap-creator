// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DayStatus {
  PENDING // today or future, not yet confirmed
  CONFIRMED // fully confirmed complete
  MISSED // past, no tasks confirmed
  RECOVERED // past, partially confirmed late
}

model Roadmap {
  id                Int      @id @default(autoincrement())
  ownerId           String
  programTitle      String   @default("The Ascent")
  programSubtitle   String   @default("FAANG Prep · 12-Week Block")
  programStartDate  DateTime
  programWeeksCount Int      @default(12)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  weeks             Week[]
  days              Day[]

  @@index([ownerId, updatedAt])
}

model Week {
  id        Int     @id @default(autoincrement())
  roadmapId Int
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  number    Int
  focus     String
  days      Day[]

  @@unique([roadmapId, number])
}

model Day {
  id             Int       @id @default(autoincrement())
  roadmapId      Int
  roadmap        Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weekId         Int
  week           Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date           DateTime
  dayOfWeek      Int // 1=Mon ... 7=Sun
  status         DayStatus @default(PENDING)
  reviewOnly     Boolean   @default(false)
  estimateMin    Int       @default(0)
  loggedMin      Int       @default(0)
  confirmedAt    DateTime?
  rescheduleNote String?
  tasks          Task[]

  @@unique([roadmapId, date])
  @@index([weekId])
}

model Task {
  id       Int     @id @default(autoincrement())
  dayId    Int
  day      Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  category String
  name     String
  meta     String?
  minutes  Int?
  link     String?
  done     Boolean @default(false)
  order    Int     @default(0)

  @@unique([dayId, order])
}
